#!/bin/sh
# Package-owned OpenWrt iface hotplug hook. The shared helper owns request logic.
[ "${ACTION:-}" = ifup ] || exit 0
[ "${INTERFACE:-}" = "$(uci -q get upnp-client.main.wan_interface || echo wan)" ] || exit 0
[ "$(uci -q get upnp-client.main.enabled)" = 1 ] || exit 0
logger -t upnp-client 'WAN is up; processing saved automatic mappings'
/usr/libexec/upnp-client-request request-auto
